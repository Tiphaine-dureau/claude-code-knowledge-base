{
  "mcpServers": {
    "notion": {
      "command": "node",
      "args": ["scripts/run-mcp.mjs", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "apify": {
      "command": "node",
      "args": [
        "scripts/run-mcp.mjs", "@apify/actors-mcp-server",
        "--tools", "apify/instagram-reel-scraper",
        "--telemetry-enabled", "false"
      ],
      "env": {
        "APIFY_TOKEN": "${APIFY_TOKEN}"
      }
    }
  }
}
