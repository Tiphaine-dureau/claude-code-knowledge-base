{
  "mcpServers": {
    "notion": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@notionhq/notion-mcp-server"],
      "env": {
        "NOTION_TOKEN": "${NOTION_TOKEN}"
      }
    },
    "apify": {
      "command": "cmd",
      "args": [
        "/c", "npx", "-y", "@apify/actors-mcp-server",
        "--tools", "apify/instagram-reel-scraper",
        "--telemetry-enabled", "false"
      ],
      "env": {
        "APIFY_TOKEN": "${APIFY_TOKEN}"
      }
    }
  }
}
